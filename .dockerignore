# Build-context filter for the api/ and worker/ images (context = repo root,
# because api/ imports worker.db — see api/Dockerfile). web/ builds from its
# own context (web/) with its own .dockerignore.
.git
.github
.claude
docs
infra
web
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
# INTENTIONAL: strip host node_modules (incl. worker/convert_node/node_modules)
# so the api/worker images rebuild a clean tree via `npm ci` from the committed
# worker/convert_node/{package.json,package-lock.json}, which sit BESIDE
# node_modules and are NOT stripped — they arrive via `COPY worker/`. Removing
# this glob would ship the host's platform-specific node_modules into the image.
**/node_modules
**/tests/samples
.env
.env.*
