# sermon.guide v0 — infrastructure environment template.
#
# Copy to `infra/.env` (gitignored) before `make up`. The defaults below are
# safe for single-developer local use only — do NOT use in production.
#
# Naming convention: every variable is prefixed `SERMON_`. See infra/AGENTS.md.

# --- Postgres 16 ---
SERMON_POSTGRES_USER=sermon
SERMON_POSTGRES_PASSWORD=sermon_local_dev
SERMON_POSTGRES_DB=sermon
SERMON_POSTGRES_PORT=5432

# --- Redis 7 ---
SERMON_REDIS_PASSWORD=sermon_local_dev
SERMON_REDIS_PORT=6379

# --- MinIO (Milvus object backend; reusable for local raw-file storage) ---
SERMON_MINIO_ROOT_USER=minioadmin
SERMON_MINIO_ROOT_PASSWORD=minioadmin
SERMON_MINIO_PORT=9000
SERMON_MINIO_CONSOLE_PORT=9001

# --- Milvus standalone ---
# 19530 = gRPC client port (pymilvus connects here).
# 9091  = HTTP health/metrics port (used by the compose healthcheck).
SERMON_MILVUS_PORT=19530
SERMON_MILVUS_HEALTH_PORT=9091

# --- Gemini summary agent (Phase 14) ---
# OPTIONAL since 2026-06-12: only needed when SERMON_API_LLM_PROVIDER=google —
# the default provider is now deepinfra (see the LLM transport block below),
# which runs /search-summary on DEEPINFRA_API_KEY instead, so this can stay
# blank. Intentionally NOT prefixed `SERMON_` — Google's docs/SDKs read the
# literal GOOGLE_API_KEY, and api/settings.py maps it through an explicit
# alias (bypassing SERMON_API_).
GOOGLE_API_KEY=

# --- LLM transport (Phase 14b, ADR 0005; default amended 2026-06-12) ---------
# Which OpenAI-compatible endpoint /search-summary talks to:
#   deepinfra (default) -> DeepInfra (https://api.deepinfra.com/v1/openai),
#                          default model google/gemini-2.5-flash, key
#                          DEEPINFRA_API_KEY (shared with embeddings/rerank/
#                          highlight below — one vendor, one key)
#   google              -> Google's compat endpoint
#                          (https://generativelanguage.googleapis.com/v1beta/openai/),
#                          default model gemini-2.5-flash, key GOOGLE_API_KEY
#   ppq                 -> ppq.ai gateway (https://api.ppq.ai/v1),
#                          default model google/gemini-2.5-flash, key PPQ_API_KEY
#SERMON_API_LLM_PROVIDER=deepinfra
# ppq.ai API key — unprefixed on purpose: it is the literal name ppq.ai's docs
# use (same pattern + rationale as GOOGLE_API_KEY).
#PPQ_API_KEY=
# Optional model-id override; unset -> the active provider's default above.
# Spell it the active provider's way (google/-prefixed on deepinfra/ppq, bare
# on google).
#SERMON_API_LLM_MODEL=

# --- remote inference (Phase 16b, ADR 0006) ---
# Every non-LLM inference leg (query/chunk embeddings, rerank, highlight) is
# a DeepInfra API call. Key name intentionally UNPREFIXED — it is the literal
# name DeepInfra's docs use; worker/inference.py reads it via validation_alias
# (same pattern as GOOGLE_API_KEY / PPQ_API_KEY). Without it, /search 503s
# and ingest fails naming this var.
DEEPINFRA_API_KEY=
# Optional overrides; the code defaults are the ADR 0006 pins:
#   SERMON_EMBEDDINGS_BASE_URL=https://api.deepinfra.com/v1/openai
#   SERMON_EMBEDDINGS_MODEL=BAAI/bge-large-en-v1.5   (exact v0 weights — also
#     pinned by the Postgres meta row; changing it is a re-embed migration,
#     never a bare env flip)
#   SERMON_RERANK_BASE_URL=https://api.deepinfra.com/v1/inference
#   SERMON_RERANK_MODEL=Qwen/Qwen3-Reranker-8B

# Optional reasoning knob (Phase 16b): "none" disables Gemini 2.5 Flash
# thinking on Google's OpenAI-compat endpoint (~60s LLM leg → seconds).
# Unset/empty → not sent.
SERMON_API_LLM_REASONING_EFFORT=

# --- Originals object storage (Phase 31) ---
# Raw uploads persist to the compose MinIO above under
# originals/{book_id}/{sanitized-filename}; the key lands in
# global_books.text_pointer (bucket auto-created, write-only -- no read
# endpoint until the B1 fidelity tier). Reuses SERMON_MINIO_ROOT_USER /
# SERMON_MINIO_ROOT_PASSWORD / SERMON_MINIO_PORT from the MinIO block.
# HOST is the host-side endpoint (never the compose-internal minio:9000).
# A future R2/B2 swap is HOST=<endpoint> PORT=443 SECURE=true + new keys.
SERMON_MINIO_HOST=localhost
SERMON_MINIO_ORIGINALS_BUCKET=sermon-originals
SERMON_MINIO_SECURE=false

# Phase 18 deployment posture: "dev" disarms the JWT-secret boot guard so
# local uvicorn (`make dev`) can run with the public placeholder secret.
# Unset or empty means "prod" = fail closed (guard armed). NEVER set "dev"
# on a deployment that faces real users.
SERMON_API_ENV=dev

# --- Phase 19: edge rate limiting + CORS prod-origin guard (api) -----------
# SERMON_API_CORS_ORIGINS — REQUIRED in prod (compose hard-fails without it).
# JSON list of the EXACT browser origin(s); the api pairs it with
# allow_credentials=True, so outside dev it REFUSES TO BOOT when the list is
# empty or contains a wildcard ("*"), an empty string, or a localhost/loopback
# origin (main.py lifespan guard). Dev default: ["http://localhost:3000"].
#SERMON_API_CORS_ORIGINS=["https://app.example.com"]
#
# SERMON_API_TRUST_PROXY_HEADERS — when true, the per-IP rate limiter keys on
# the RIGHTMOST X-Forwarded-For entry (the hop written by our own proxy —
# unforgeable whether Caddy replaces inbound XFF, the modern default, or
# appends; non-IP values fall back to the TCP peer). ONLY safe behind a
# proxy hop that writes the header itself (prod compose: Caddy -> web -> api,
# web forwards Caddy's value verbatim). Default false = fail closed. NEVER
# enable where clients can reach :8000 directly (e.g. the dev box's
# host-published api port).
#SERMON_API_TRUST_PROXY_HEADERS=false
#
# SERMON_API_RATELIMIT_* — Redis-backed buckets (broker Redis, logical db 2;
# cross-replica). Format "<max requests>/<window seconds>"; malformed values
# fail at boot. 429 + Retry-After past the limit; Redis-down fails OPEN with
# a logged warning; ENABLED=false is the operational kill switch. Bucket
# table + how to add one: api/AGENTS.md.
#SERMON_API_RATELIMIT_ENABLED=true
#SERMON_API_RATELIMIT_SIGNUP_IP=5/60
#SERMON_API_RATELIMIT_LOGIN_IP=10/60
#SERMON_API_RATELIMIT_SUMMARY_USER=5/60
